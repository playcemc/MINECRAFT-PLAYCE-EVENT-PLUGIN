# =========================================================
# PLAYCE 3인 협동 보물찾기 - 통합본
# Paper 1.21.1 + Skript
#
# 핵심 규칙
# - 게임 시작부터 3번째 보물 최종 확인까지 초 단위 타이머 측정
# - 공식 3인 플레이 TOP 10 랭킹 영구 저장 (1인 테스트 기록은 미등록)
# 1) /보물게임 GUI에서 역할을 직접 지정하거나 1인 테스트 시작
#    수동 명령: /보물게임시작 <말못하는사람> <못듣는사람> <안보이는사람>
#    테스트 명령: /보물게임테스트
#    - 말 못함: 마이크/채팅 금지
#    - 못 들음: 일반 마인크래프트 채팅 수신 차단
#    - 안 보임: 상시 실명
#
# 2) 보물 3개 위치는 후보 목록에서 서로 다른 3곳을 미리 추첨
#    - 실제 라임색 유광 테라코타는 현재 단계의 보물만 생성
#    - 보물(라임색 유광 테라코타)은 참가자 3명이 모두 우클릭해야 클리어
#
# 3) 좌표 분배 (현재 버전)
#    - 말 못함: X, Y
#    - 못 들음: Z
#
# 4) 말 못함 투명화
#    - 1~2번째 보물: 10초 투명 / 3초 노출 반복
#    - 3번째 보물: 상시 투명
#
# 5) 1번/2번 보물 클리어 후 5x5 우클릭 미니게임
#    - 범위: X -24~-20 / Y 15 / Z -295~-291
#    - 세 명이 미니게임 근처에 모이면 패턴 5초 공개
#    - 정답 패널 8개를 랜덤 선정
#    - 공개 후 전부 흰색으로 숨김
#    - "안 보이는 사람"만 우클릭 입력 가능
#    - 맞는 패널: 초록색으로 언락
#    - 틀린 패널: 즉시 실패
#    - 실패: 세 명 모두 (4, 15, -44)로 텔레포트
#      이후 직접 미니게임 장소로 다시 이동해야 재도전
#
# 중요
# - /보물게임시작 명령을 실행할 때 세 참가자가 모두
#   "보물찾기 맵 월드"에 있어야 합니다.
# - 후보 보물 좌표는 원래 AIR인 지점을 전제로 합니다.
# - 퍼즐 25칸은 스크립트가 회색/초록/흰색 콘크리트로 덮어씁니다.
# =========================================================

options:
    treasure-prefix: &8[&6보물찾기&8] &f
    puzzle-correct-count: 8
    puzzle-reveal-seconds: 5
    puzzle-start-radius: 10

# ---------------------------------------------------------
# 공통 함수
# ---------------------------------------------------------

function formatTreasureTime(sec: number) :: text:
    set {_m} to floor({_sec} / 60)
    set {_s} to {_sec} - ({_m} * 60)

    if {_s} < 10:
        return "%{_m}%:0%{_s}%"

    return "%{_m}%:%{_s}%"

function saveTreasureRanking(seconds: number) :: number:
    set {_team} to "말못함:%{treasure.mute}% / 못들음:%{treasure.deaf}% / 안보임:%{treasure.blind}%"
    set {_insert} to 0

    loop 10 times:
        if {treasure.rank.time::%loop-number%} is not set:
            set {_insert} to loop-number
            stop loop

        if {_seconds} < {treasure.rank.time::%loop-number%}:
            set {_insert} to loop-number
            stop loop

    if {_insert} is 0:
        return 0

    # 뒤에서부터 한 칸씩 밀기
    loop 10 times:
        set {_dest} to 11 - loop-number

        if {_dest} > {_insert}:
            set {_src} to {_dest} - 1

            if {treasure.rank.time::%{_src}%} is set:
                set {treasure.rank.time::%{_dest}%} to {treasure.rank.time::%{_src}%}
                set {treasure.rank.team::%{_dest}%} to {treasure.rank.team::%{_src}%}
            else:
                delete {treasure.rank.time::%{_dest}%}
                delete {treasure.rank.team::%{_dest}%}

    set {treasure.rank.time::%{_insert}%} to {_seconds}
    set {treasure.rank.team::%{_insert}%} to {_team}

    return {_insert}

function showTreasureRanking(p: player):
    send "&8&m------------------------------------------------" to {_p}
    send "&6&l보물찾기 TOP 10" to {_p}

    set {_has} to false

    loop 10 times:
        if {treasure.rank.time::%loop-number%} is set:
            set {_has} to true
            set {_time} to formatTreasureTime({treasure.rank.time::%loop-number%})
            send "&e%loop-number%위 &f%{_time}% &8- &7%{treasure.rank.team::%loop-number%}%" to {_p}

    if {_has} is false:
        send "&7아직 공식 3인 플레이 기록이 없습니다." to {_p}

    send "&8&m------------------------------------------------" to {_p}

function treasureLocFromRaw(raw: text) :: location:
    set {_p::*} to {_raw} split at " "
    set {_x} to {_p::1} parsed as number
    set {_y} to {_p::2} parsed as number
    set {_z} to {_p::3} parsed as number
    return location({_x}, {_y}, {_z}, {treasure.world})

function puzzleTileLoc(index: number) :: location:
    # 1~25 -> (-24,-295)부터 5x5로 매핑
    set {_zero} to {_index} - 1
    set {_row} to floor({_zero} / 5)
    set {_col} to {_zero} - ({_row} * 5)
    set {_x} to -24 + {_row}
    set {_z} to -295 + {_col}
    return location({_x}, 15, {_z}, {treasure.world})

function isTreasurePlayer(p: player) :: boolean:
    if {treasure.testmode} is true:
        if {_p} is {treasure.tester}:
            return true
    if {_p} is {treasure.mute}:
        return true
    if {_p} is {treasure.deaf}:
        return true
    if {_p} is {treasure.blind}:
        return true
    return false

function paintPuzzleHidden():
    if {treasure.world} is not set:
        stop
    loop 25 times:
        set {_loc} to puzzleTileLoc(loop-number)
        set block at {_loc} to white concrete

function giveTreasureHint(stage: number):
    set {_raw} to {treasure.selectedRaw::%{_stage}%}
    if {_raw} is not set:
        stop

    set {_p::*} to {_raw} split at " "
    set {_x} to {_p::1}
    set {_y} to {_p::2}
    set {_z} to {_p::3}

    if {treasure.testmode} is true:
        if {treasure.tester} is online:
            send title "&e&l테스트 좌표" with subtitle "&fX=%{_x}% / Y=%{_y}% / Z=%{_z}%" to {treasure.tester} for 6 seconds
        stop

    if {treasure.mute} is online:
        send title "&e&l좌표 정보 획득" with subtitle "&fX = &e%{_x}% &7/ &fY = &e%{_y}%" to {treasure.mute} for 6 seconds

    if {treasure.deaf} is online:
        # 못 듣는 역할은 일반 채팅은 안 보이지만 Title / ActionBar는 볼 수 있게 설계
        send title "&b&l좌표 정보 획득" with subtitle "&fZ = &b%{_z}%" to {treasure.deaf} for 6 seconds

    if {treasure.blind} is online:
        send title "&7&l%{_stage}%번째 보물 탐색" with subtitle "&f두 사람의 안내를 따라가세요." to {treasure.blind} for 5 seconds

function clearTreasureGame():
    # 생성된 보물 블록 제거
    loop 3 times:
        if {treasure.selected::%loop-number%} is set:
            set block at {treasure.selected::%loop-number%} to air

    # 퍼즐 바닥은 흰색으로 정리
    if {treasure.world} is set:
        paintPuzzleHidden()

    # 참가자에게 남아 있는 상태 효과를 전부 제거
    # (실명, 투명화 등 게임 중 부여된 효과가 종료 후 남지 않도록 함)
    loop {treasure.players::*}:
        if loop-value is online:
            set {_n} to name of loop-value
            execute console command "effect clear %{_n}%"

    delete {treasure.active}
    delete {treasure.world}
    delete {treasure.players::*}
    delete {treasure.mute}
    delete {treasure.deaf}
    delete {treasure.blind}
    delete {treasure.current}
    delete {treasure.selected::*}
    delete {treasure.selectedRaw::*}
    delete {treasure.clicked::*}
    delete {treasure.testClicks::*}
    delete {treasure.completed::*}
    delete {treasure.puzzle.pending}
    delete {treasure.puzzle.active}
    delete {treasure.puzzle.revealing}
    delete {treasure.puzzle.number}
    delete {treasure.puzzle.near}
    delete {treasure.puzzle.expected}
    delete {treasure.puzzle.correct::*}
    delete {treasure.puzzle.unlocked::*}
    delete {treasure.invis.counter}
    delete {treasure.invis.permanent}
    delete {treasure.timer.seconds}
    delete {treasure.timer.running}
    delete {treasure.testmode}
    delete {treasure.tester}

function failPuzzle():
    set {treasure.puzzle.active} to false
    set {treasure.puzzle.revealing} to false
    set {treasure.puzzle.pending} to true
    set {treasure.puzzle.near} to 0
    set {treasure.puzzle.expected} to size of {treasure.players::*}
    delete {treasure.puzzle.correct::*}
    delete {treasure.puzzle.unlocked::*}
    paintPuzzleHidden()

    set {_fail} to location(4, 15, -44, {treasure.world})

    loop {treasure.players::*}:
        if loop-value is online:
            teleport loop-value to {_fail}
            send title "&c&l미션 실패" with subtitle "&f미션 장소까지 다시 이동하세요." to loop-value for 5 seconds

function completePuzzle():
    set {treasure.puzzle.active} to false
    set {treasure.puzzle.revealing} to false
    set {treasure.puzzle.pending} to false
    delete {treasure.puzzle.correct::*}
    delete {treasure.puzzle.unlocked::*}
    paintPuzzleHidden()

    set {_next} to {treasure.current} + 1
    set {treasure.current} to {_next}

    # 다음 보물을 이제서야 실제로 생성
    set block at {treasure.selected::%{_next}%} to lime glazed terracotta

    # 3번째 보물부터 말 못하는 사람 상시 투명
    if {_next} is 3:
        if {treasure.testmode} is not true:
            set {treasure.invis.permanent} to true
            if {treasure.mute} is online:
                set {_n} to name of {treasure.mute}
                execute console command "effect give %{_n}% minecraft:invisibility infinite 0 true"

    loop {treasure.players::*}:
        if loop-value is online:
            send title "&a&l미션 성공!" with subtitle "&f%{_next}%번째 보물의 정보가 해금되었습니다." to loop-value for 4 seconds

    wait 2 seconds
    if {treasure.active} is true:
        giveTreasureHint({_next})


# ---------------------------------------------------------
# 게임 시작 공통 함수 / 1인 테스트 / GUI
# ---------------------------------------------------------

function startTreasureNormal(mute: player, deaf: player, blind: player, starter: player):
    if {treasure.active} is true:
        send "{@treasure-prefix}&c이미 보물찾기 게임이 진행 중입니다." to {_starter}
        stop

    if {_mute} is {_deaf}:
        send "{@treasure-prefix}&c서로 다른 플레이어 3명을 지정해야 합니다." to {_starter}
        stop
    if {_mute} is {_blind}:
        send "{@treasure-prefix}&c서로 다른 플레이어 3명을 지정해야 합니다." to {_starter}
        stop
    if {_deaf} is {_blind}:
        send "{@treasure-prefix}&c서로 다른 플레이어 3명을 지정해야 합니다." to {_starter}
        stop

    if world of {_deaf} is not world of {_mute}:
        send "{@treasure-prefix}&c세 참가자가 같은 월드에 있어야 합니다." to {_starter}
        stop
    if world of {_blind} is not world of {_mute}:
        send "{@treasure-prefix}&c세 참가자가 같은 월드에 있어야 합니다." to {_starter}
        stop

    delete {treasure.testmode}
    delete {treasure.tester}

    set {treasure.world} to world of {_mute}

    delete {treasure.players::*}
    add {_mute} to {treasure.players::*}
    add {_deaf} to {treasure.players::*}
    add {_blind} to {treasure.players::*}

    set {treasure.mute} to {_mute}
    set {treasure.deaf} to {_deaf}
    set {treasure.blind} to {_blind}

    # 시작 전 잔여 효과 제거 + 참가자 전원 시작 위치 이동
    set {_startLoc} to location(4, 15, -44, {treasure.world})
    loop {treasure.players::*}:
        if loop-value is online:
            set {_n} to name of loop-value
            execute console command "effect clear %{_n}%"
            teleport loop-value to {_startLoc}

    # AIR인 후보만 추림
    delete {_available::*}
    loop {treasure.spots::*}:
        set {_loc} to treasureLocFromRaw(loop-value)
        if block at {_loc} is air:
            add loop-value to {_available::*}

    if size of {_available::*} < 3:
        send "{@treasure-prefix}&c현재 사용할 수 있는 보물 후보가 3개 미만입니다." to {_starter}
        delete {treasure.world}
        delete {treasure.players::*}
        delete {treasure.mute}
        delete {treasure.deaf}
        delete {treasure.blind}
        stop

    loop 3 times:
        set {_raw} to random element out of {_available::*}
        remove {_raw} from {_available::*}
        set {treasure.selectedRaw::%loop-number%} to {_raw}
        set {treasure.selected::%loop-number%} to treasureLocFromRaw({_raw})

    set block at {treasure.selected::1} to lime glazed terracotta

    set {treasure.current} to 1
    set {treasure.timer.seconds} to 0
    set {treasure.timer.running} to true
    set {treasure.active} to true
    set {treasure.invis.counter} to 0
    delete {treasure.invis.permanent}
    delete {treasure.clicked::*}
    delete {treasure.testClicks::*}
    delete {treasure.completed::*}

    set {_blindName} to name of {treasure.blind}
    execute console command "effect give %{_blindName}% minecraft:blindness infinite 0 true"

    set {_muteName} to name of {treasure.mute}
    execute console command "effect give %{_muteName}% minecraft:invisibility infinite 0 true"

    send title "&c&l말 못하는 사람" with subtitle "&f마이크/마인크래프트 채팅 사용 금지" to {treasure.mute} for 6 seconds
    send title "&b&l못 듣는 사람" with subtitle "&f헤드셋 금지 / 일반 채팅도 보이지 않습니다." to {treasure.deaf} for 6 seconds
    send title "&8&l안 보이는 사람" with subtitle "&f상시 실명 상태입니다." to {treasure.blind} for 6 seconds

    send "{@treasure-prefix}&a지정한 역할로 게임을 시작했습니다." to {_starter}
    send "&7말 못함: &f%{treasure.mute}%" to {_starter}
    send "&7못 들음: &f%{treasure.deaf}%" to {_starter}
    send "&7안 보임: &f%{treasure.blind}%" to {_starter}
    send "&71번 보물: &f%{treasure.selectedRaw::1}%" to {_starter}
    send "&72번 보물: &f%{treasure.selectedRaw::2}%" to {_starter}
    send "&73번 보물: &f%{treasure.selectedRaw::3}%" to {_starter}

    wait 4 seconds
    if {treasure.active} is true:
        giveTreasureHint(1)

function startTreasureTest(tester: player):
    if {treasure.active} is true:
        send "{@treasure-prefix}&c이미 보물찾기 게임이 진행 중입니다." to {_tester}
        stop

    set {treasure.testmode} to true
    set {treasure.tester} to {_tester}
    set {treasure.world} to world of {_tester}

    delete {treasure.mute}
    delete {treasure.deaf}
    delete {treasure.blind}

    delete {treasure.players::*}
    add {_tester} to {treasure.players::*}

    # 테스트 시작도 동일한 시작 위치에서 진행
    set {_testerName} to name of {_tester}
    execute console command "effect clear %{_testerName}%"
    teleport {_tester} to location(4, 15, -44, {treasure.world})

    delete {_available::*}
    loop {treasure.spots::*}:
        set {_loc} to treasureLocFromRaw(loop-value)
        if block at {_loc} is air:
            add loop-value to {_available::*}

    if size of {_available::*} < 3:
        send "{@treasure-prefix}&c현재 사용할 수 있는 보물 후보가 3개 미만입니다." to {_tester}
        delete {treasure.testmode}
        delete {treasure.tester}
        delete {treasure.world}
        delete {treasure.players::*}
        stop

    loop 3 times:
        set {_raw} to random element out of {_available::*}
        remove {_raw} from {_available::*}
        set {treasure.selectedRaw::%loop-number%} to {_raw}
        set {treasure.selected::%loop-number%} to treasureLocFromRaw({_raw})

    set block at {treasure.selected::1} to lime glazed terracotta

    set {treasure.current} to 1
    set {treasure.timer.seconds} to 0
    set {treasure.timer.running} to true
    set {treasure.active} to true
    set {treasure.invis.counter} to 0
    delete {treasure.invis.permanent}
    delete {treasure.clicked::*}
    delete {treasure.testClicks::*}
    delete {treasure.completed::*}

    send title "&e&l1인 테스트 모드" with subtitle "&f역할 제약 없이 전체 진행을 테스트합니다." to {_tester} for 6 seconds
    send "{@treasure-prefix}&e1인 테스트를 시작했습니다." to {_tester}
    send "&7보물은 같은 블록을 &f3번 우클릭&7하면 클리어 처리됩니다." to {_tester}
    send "&7미니게임은 혼자 근처에 도착하면 시작되며 직접 우클릭할 수 있습니다." to {_tester}
    send "&71번 보물: &f%{treasure.selectedRaw::1}%" to {_tester}
    send "&72번 보물: &f%{treasure.selectedRaw::2}%" to {_tester}
    send "&73번 보물: &f%{treasure.selectedRaw::3}%" to {_tester}

    wait 2 seconds
    if {treasure.active} is true:
        giveTreasureHint(1)

function openTreasureMain(p: player):
    set {_gui} to chest inventory with 3 rows named "보물찾기 관리"
    set slot 11 of {_gui} to lime concrete named "&a&l일반 게임 시작"
    set slot 13 of {_gui} to yellow concrete named "&e&l1인 테스트 시작"
    set slot 15 of {_gui} to book named "&b&l게임 상태"
    set slot 17 of {_gui} to gold ingot named "&6&l랭킹 보기"
    set slot 22 of {_gui} to barrier named "&c&l게임 강제 종료"
    open {_gui} to {_p}

function openMuteSelect(p: player):
    set {_key} to "%{_p}%"
    delete {treasure.gui.map::%{_key}%::*}
    delete {treasure.gui.mute::%{_key}%}
    delete {treasure.gui.deaf::%{_key}%}
    delete {treasure.gui.blind::%{_key}%}

    set {_gui} to chest inventory with 6 rows named "역할 선택 - 말 못함"
    set {_slot} to 0
    loop all players:
        if {_slot} < 53:
            set slot {_slot} of {_gui} to paper named "&f%loop-player%"
            set {treasure.gui.map::%{_key}%::%{_slot}%} to loop-player
            add 1 to {_slot}
    set slot 53 of {_gui} to barrier named "&c취소"
    open {_gui} to {_p}

function openDeafSelect(p: player):
    set {_key} to "%{_p}%"
    delete {treasure.gui.map::%{_key}%::*}
    set {_mute} to {treasure.gui.mute::%{_key}%}

    set {_gui} to chest inventory with 6 rows named "역할 선택 - 못 들음"
    set {_slot} to 0
    loop all players:
        if loop-player is not {_mute}:
            if {_slot} < 53:
                set slot {_slot} of {_gui} to paper named "&f%loop-player%"
                set {treasure.gui.map::%{_key}%::%{_slot}%} to loop-player
                add 1 to {_slot}
    set slot 53 of {_gui} to barrier named "&c취소"
    open {_gui} to {_p}

function openBlindSelect(p: player):
    set {_key} to "%{_p}%"
    delete {treasure.gui.map::%{_key}%::*}
    set {_mute} to {treasure.gui.mute::%{_key}%}
    set {_deaf} to {treasure.gui.deaf::%{_key}%}

    set {_gui} to chest inventory with 6 rows named "역할 선택 - 안 보임"
    set {_slot} to 0
    loop all players:
        if loop-player is not {_mute}:
            if loop-player is not {_deaf}:
                if {_slot} < 53:
                    set slot {_slot} of {_gui} to paper named "&f%loop-player%"
                    set {treasure.gui.map::%{_key}%::%{_slot}%} to loop-player
                    add 1 to {_slot}
    set slot 53 of {_gui} to barrier named "&c취소"
    open {_gui} to {_p}

function openTreasureConfirm(p: player):
    set {_key} to "%{_p}%"
    set {_mute} to {treasure.gui.mute::%{_key}%}
    set {_deaf} to {treasure.gui.deaf::%{_key}%}
    set {_blind} to {treasure.gui.blind::%{_key}%}

    set {_gui} to chest inventory with 3 rows named "보물찾기 시작 확인"
    set slot 10 of {_gui} to red wool named "&c말 못함: &f%{_mute}%"
    set slot 12 of {_gui} to light blue wool named "&b못 들음: &f%{_deaf}%"
    set slot 14 of {_gui} to black wool named "&8안 보임: &f%{_blind}%"
    set slot 16 of {_gui} to lime concrete named "&a&l이 역할로 게임 시작"
    set slot 22 of {_gui} to barrier named "&c취소"
    open {_gui} to {_p}


