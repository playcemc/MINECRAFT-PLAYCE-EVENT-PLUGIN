# ---------------------------------------------------------
# 게임 시작 / 종료
# ---------------------------------------------------------

command /보물게임:
    permission: op
    trigger:
        if sender is not a player:
            send "{@treasure-prefix}&c이 GUI는 게임 안에서만 열 수 있습니다."
            stop
        openTreasureMain(player)

command /보물게임시작 <player> <player> <player>:
    permission: op
    trigger:
        if sender is not a player:
            send "{@treasure-prefix}&c이 명령은 게임 안에서 실행해 주세요."
            stop
        startTreasureNormal(argument 1, argument 2, argument 3, player)

command /보물게임테스트:
    permission: op
    trigger:
        if sender is not a player:
            send "{@treasure-prefix}&c이 명령은 게임 안에서 실행해 주세요."
            stop
        startTreasureTest(player)

command /보물게임종료:
    permission: op
    trigger:
        if {treasure.active} is not true:
            send "{@treasure-prefix}&7현재 진행 중인 게임이 없습니다."
            stop
        clearTreasureGame()
        send "{@treasure-prefix}&c게임을 강제로 종료하고 초기화했습니다."

command /보물디버그:
    permission: op
    trigger:
        send "&8&m--------------------------------"
        send "&6&l보물찾기 디버그"
        send "&7active: &f%{treasure.active}%"
        send "&7testmode: &f%{treasure.testmode}%"
        send "&7tester: &f%{treasure.tester}%"
        send "&7current stage: &f%{treasure.current}%"
        send "&7target raw: &f%{treasure.selectedRaw::%{treasure.current}%}%"

        if {treasure.selected::%{treasure.current}%} is set:
            set {_b} to block at {treasure.selected::%{treasure.current}%}
            send "&7target block type: &f%type of {_b}%"
        else:
            send "&7target block: &c없음"

        send "&71인 클릭 카운트: &f%{treasure.testClicks::%{treasure.current}%}%"
        send "&8&m--------------------------------"

command /퍼즐클릭진단:
    permission: op
    trigger:
        send "&8&m--------------------------------"
        send "&d&l퍼즐 클릭 진단"
        send "&7현재 퍼즐 active: &f%{treasure.puzzle.active}%"
        send "&7테스트 모드: &f%{treasure.testmode}%"
        send "&7입력 대상: &f5x5 범위 안의 흰색 콘크리트"
        send "&7입력 범위: &fX -24~-20 / Y 15 / Z -295~-291"
        send "&7설명: &f흰색 패널을 우클릭하면"
        send "&7      &f'[테스트] 패널 클릭 감지' 메시지가 떠야 합니다."
        send "&8&m--------------------------------"

command /퍼즐디버그:
    permission: op
    trigger:
        send "&8&m--------------------------------"
        send "&d&l5x5 미니게임 디버그"
        send "&7게임 active: &f%{treasure.active}%"
        send "&7pending: &f%{treasure.puzzle.pending}%"
        send "&7revealing: &f%{treasure.puzzle.revealing}%"
        send "&7active: &f%{treasure.puzzle.active}%"
        send "&7현재 보물 단계: &f%{treasure.current}%"
        send "&7미니게임 번호: &f%{treasure.puzzle.number}%"
        send "&7도착 인원: &f%{treasure.puzzle.near}%&7/&f%{treasure.puzzle.expected}%"
        send "&7정답 패널 수: &f%size of {treasure.puzzle.correct::*}%"
        send "&7언락 수: &f%size of {treasure.puzzle.unlocked::*}%"

        set {_white} to 0
        set {_lime} to 0
        set {_gray} to 0
        set {_red} to 0

        loop 25 times:
            set {_tile} to puzzleTileLoc(loop-number)
            set {_type} to type of block at {_tile}

            if {_type} is white concrete:
                add 1 to {_white}
            if {_type} is lime concrete:
                add 1 to {_lime}
            if {_type} is gray concrete:
                add 1 to {_gray}
            if {_type} is red concrete:
                add 1 to {_red}

        send "&7현재 25칸: &f흰색 %{_white}% / 라임 %{_lime}% / 회색 %{_gray}% / 빨강 %{_red}%"
        send "&7중앙: &f-22 16 -293"
        send "&7입력 블록 Y: &f15"
        send "&8&m--------------------------------"

command /퍼즐이동:
    permission: op
    trigger:
        if {treasure.active} is not true:
            send "{@treasure-prefix}&c게임이 진행 중이 아닙니다."
            stop

        if {treasure.testmode} is true:
            teleport player to location(-22, 16, -293, {treasure.world})
            send "{@treasure-prefix}&e테스터를 미니게임 중앙으로 이동했습니다."
            stop

        loop {treasure.players::*}:
            if loop-value is online:
                teleport loop-value to location(-22, 16, -293, {treasure.world})

        send "{@treasure-prefix}&e참가자 전원을 미니게임 중앙으로 이동했습니다."

command /보물랭킹:
    permission: op
    trigger:
        if sender is not a player:
            send "게임 안에서 실행해 주세요."
            stop

        showTreasureRanking(player)

command /보물게임상태:
    permission: op
    trigger:
        if {treasure.active} is not true:
            send "{@treasure-prefix}&7현재 진행 중인 게임이 없습니다."
            stop

        send "&8&m--------------------------------"
        send "&6&l보물찾기 현재 상태"
        if {treasure.testmode} is true:
            send "&e모드: &f1인 테스트"
            send "&7테스터: &f%{treasure.tester}%"
        else:
            send "&7말 못함: &f%{treasure.mute}%"
            send "&7못 들음: &f%{treasure.deaf}%"
            send "&7안 보임: &f%{treasure.blind}%"
        set {_time} to formatTreasureTime({treasure.timer.seconds})
        send "&7진행 시간: &f%{_time}%"
        send "&7현재 보물 단계: &f%{treasure.current}%"
        send "&71번: &f%{treasure.selectedRaw::1}%"
        send "&72번: &f%{treasure.selectedRaw::2}%"
        send "&73번: &f%{treasure.selectedRaw::3}%"
        if {treasure.puzzle.pending} is true:
            send "&d미니게임: &f이동 대기"
        else if {treasure.puzzle.revealing} is true:
            send "&d미니게임: &f패턴 공개 중"
        else if {treasure.puzzle.active} is true:
            send "&d미니게임: &f입력 중"
        send "&8&m--------------------------------"


# ---------------------------------------------------------
# 게임 시작 GUI 클릭 처리
# ---------------------------------------------------------

on inventory click:
    if name of event-inventory is "보물찾기 관리":
        cancel event
        if event-slot is not set:
            stop

        set {_slot} to index of event-slot

        if {_slot} is 11:
            close player's inventory
            wait 1 tick
            openMuteSelect(player)
            stop

        if {_slot} is 13:
            close player's inventory
            wait 1 tick
            startTreasureTest(player)
            stop

        if {_slot} is 15:
            cancel event
            if {treasure.active} is not true:
                send "{@treasure-prefix}&7현재 진행 중인 게임이 없습니다." to player
            else:
                set {_time} to formatTreasureTime({treasure.timer.seconds})
                send "&8&m--------------------------------" to player
                send "&6&l보물찾기 현재 상태" to player
                if {treasure.testmode} is true:
                    send "&e모드: &f1인 테스트" to player
                    send "&7테스터: &f%{treasure.tester}%" to player
                else:
                    send "&7말 못함: &f%{treasure.mute}%" to player
                    send "&7못 들음: &f%{treasure.deaf}%" to player
                    send "&7안 보임: &f%{treasure.blind}%" to player
                send "&7진행 시간: &f%{_time}%" to player
                send "&7현재 보물 단계: &f%{treasure.current}%" to player
                send "&8&m--------------------------------" to player
            stop

        if {_slot} is 17:
            close player's inventory
            showTreasureRanking(player)
            stop

        if {_slot} is 22:
            close player's inventory
            if {treasure.active} is true:
                clearTreasureGame()
                send "{@treasure-prefix}&c게임을 강제로 종료하고 초기화했습니다." to player
            else:
                send "{@treasure-prefix}&7현재 진행 중인 게임이 없습니다." to player
            stop

    if name of event-inventory is "역할 선택 - 말 못함":
        cancel event
        if event-slot is not set:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 53:
            close player's inventory
            stop

        set {_key} to "%player%"
        set {_target} to {treasure.gui.map::%{_key}%::%{_slot}%}
        if {_target} is not set:
            stop

        set {treasure.gui.mute::%{_key}%} to {_target}
        close player's inventory
        wait 1 tick
        openDeafSelect(player)
        stop

    if name of event-inventory is "역할 선택 - 못 들음":
        cancel event
        if event-slot is not set:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 53:
            close player's inventory
            stop

        set {_key} to "%player%"
        set {_target} to {treasure.gui.map::%{_key}%::%{_slot}%}
        if {_target} is not set:
            stop

        set {treasure.gui.deaf::%{_key}%} to {_target}
        close player's inventory
        wait 1 tick
        openBlindSelect(player)
        stop

    if name of event-inventory is "역할 선택 - 안 보임":
        cancel event
        if event-slot is not set:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 53:
            close player's inventory
            stop

        set {_key} to "%player%"
        set {_target} to {treasure.gui.map::%{_key}%::%{_slot}%}
        if {_target} is not set:
            stop

        set {treasure.gui.blind::%{_key}%} to {_target}
        close player's inventory
        wait 1 tick
        openTreasureConfirm(player)
        stop

    if name of event-inventory is "보물찾기 시작 확인":
        cancel event
        if event-slot is not set:
            stop
        set {_slot} to index of event-slot
        set {_key} to "%player%"

        if {_slot} is 16:
            set {_mute} to {treasure.gui.mute::%{_key}%}
            set {_deaf} to {treasure.gui.deaf::%{_key}%}
            set {_blind} to {treasure.gui.blind::%{_key}%}

            close player's inventory

            if {_mute} is not set:
                send "{@treasure-prefix}&c말 못하는 역할 선택값이 없습니다." to player
                stop
            if {_deaf} is not set:
                send "{@treasure-prefix}&c못 듣는 역할 선택값이 없습니다." to player
                stop
            if {_blind} is not set:
                send "{@treasure-prefix}&c안 보이는 역할 선택값이 없습니다." to player
                stop

            startTreasureNormal({_mute}, {_deaf}, {_blind}, player)

            delete {treasure.gui.map::%{_key}%::*}
            delete {treasure.gui.mute::%{_key}%}
            delete {treasure.gui.deaf::%{_key}%}
            delete {treasure.gui.blind::%{_key}%}
            stop

        if {_slot} is 22:
            close player's inventory
            delete {treasure.gui.map::%{_key}%::*}
            delete {treasure.gui.mute::%{_key}%}
            delete {treasure.gui.deaf::%{_key}%}
            delete {treasure.gui.blind::%{_key}%}
            stop


# ---------------------------------------------------------
# 채팅 제약
# ---------------------------------------------------------

on chat:
    if {treasure.active} is not true:
        stop
    if {treasure.testmode} is true:
        stop

    # 말 못하는 사람: 채팅 송신 금지
    if player is {treasure.mute}:
        cancel event
        send action bar "&c말 못하는 역할은 채팅을 사용할 수 없습니다." to player
        stop

    # 못 듣는 사람: 모든 일반 플레이어 채팅 수신에서 제외
    if {treasure.deaf} is online:
        remove {treasure.deaf} from chat recipients

# ---------------------------------------------------------
# 실명 / 투명화 유지 + 좌표 HUD
# ---------------------------------------------------------

every 1 second:
    if {treasure.active} is not true:
        stop

    if {treasure.timer.running} is true:
        add 1 to {treasure.timer.seconds}

    set {_gameTime} to formatTreasureTime({treasure.timer.seconds})

    # -----------------------------------------------------
    # 1인 테스트 모드
    # 역할 제약 없이 본인 좌표 + 현재 목표 좌표 표시
    # -----------------------------------------------------
    if {treasure.testmode} is true:
        if {treasure.tester} is online:
            set {_px} to floor(x-coordinate of {treasure.tester})
            set {_py} to floor(y-coordinate of {treasure.tester})
            set {_pz} to floor(z-coordinate of {treasure.tester})

            if {treasure.puzzle.pending} is true:
                send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &d미니게임 이동 &7(%{treasure.puzzle.near}%/%{treasure.puzzle.expected}%)" to {treasure.tester}

            else if {treasure.puzzle.revealing} is true:
                send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &e패턴을 기억하세요!" to {treasure.tester}

            else if {treasure.puzzle.active} is true:
                send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &a정답 패널을 우클릭" to {treasure.tester}

            else:
                set {_raw} to {treasure.selectedRaw::%{treasure.current}%}
                if {_raw} is set:
                    set {_p::*} to {_raw} split at " "
                    send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &e보물 %{treasure.current}%: &f%{_p::1}% %{_p::2}% %{_p::3}%" to {treasure.tester}
                else:
                    send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}%" to {treasure.tester}
        stop

    # -----------------------------------------------------
    # 본게임 역할 효과 유지
    # -----------------------------------------------------

    # 실명 유지
    if {treasure.blind} is online:
        set {_blindName} to name of {treasure.blind}
        execute console command "effect give %{_blindName}% minecraft:blindness infinite 0 true"

    # 3번째 보물은 말 못하는 사람 상시 투명
    if {treasure.current} is 3:
        if {treasure.mute} is online:
            set {_muteName} to name of {treasure.mute}
            execute console command "effect give %{_muteName}% minecraft:invisibility infinite 0 true"
        set {treasure.invis.permanent} to true

    # 1~2번째: 10초 투명 / 3초 노출
    else:
        add 1 to {treasure.invis.counter}

        if {treasure.invis.counter} is 10:
            if {treasure.mute} is online:
                set {_muteName} to name of {treasure.mute}
                execute console command "effect clear %{_muteName}% minecraft:invisibility"

        if {treasure.invis.counter} >= 13:
            set {treasure.invis.counter} to 0
            if {treasure.mute} is online:
                set {_muteName} to name of {treasure.mute}
                execute console command "effect give %{_muteName}% minecraft:invisibility infinite 0 true"

    # -----------------------------------------------------
    # 모든 참가자에게 본인 좌표를 ActionBar로 상시 표시
    # 역할별 보물 정보도 같은 줄 오른쪽에 함께 표시
    # -----------------------------------------------------
    loop {treasure.players::*}:
        if loop-value is online:
            set {_px} to floor(x-coordinate of loop-value)
            set {_py} to floor(y-coordinate of loop-value)
            set {_pz} to floor(z-coordinate of loop-value)

            if {treasure.puzzle.pending} is true:
                send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &d미니게임 이동 &7(%{treasure.puzzle.near}%/%{treasure.puzzle.expected}%)" to loop-value

            else if {treasure.puzzle.revealing} is true:
                send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &e패턴을 기억하세요!" to loop-value

            else if {treasure.puzzle.active} is true:
                if loop-value is {treasure.blind}:
                    send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &a패널을 우클릭하세요." to loop-value
                else:
                    send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &a안 보이는 사람을 안내하세요." to loop-value

            else:
                set {_raw} to {treasure.selectedRaw::%{treasure.current}%}

                if {_raw} is set:
                    set {_p::*} to {_raw} split at " "

                    if loop-value is {treasure.mute}:
                        send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &e보물 %{treasure.current}% &fX:%{_p::1}% Y:%{_p::2}%" to loop-value

                    else if loop-value is {treasure.deaf}:
                        send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}% &8| &b보물 %{treasure.current}% &fZ:%{_p::3}%" to loop-value

                    else:
                        send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}%" to loop-value

                else:
                    send action bar "&6%{_gameTime}% &8| &7내 좌표 &fX:%{_px}% Y:%{_py}% Z:%{_pz}%" to loop-value

# ---------------------------------------------------------
# 보물 우클릭
# ---------------------------------------------------------
#
# lime_glazed_terracotta 전용 우클릭 이벤트를 직접 사용합니다.
# generic on rightclick에서 여러 조건으로 걸러지던 문제를 피하기 위한 버전입니다.
# ---------------------------------------------------------

on any right click on lime glazed terracotta:
    if {treasure.active} is not true:
        stop

    set {_stage} to {treasure.current}
    if {_stage} is not set:
        stop

    if {treasure.selected::%{_stage}%} is not set:
        stop

    # Skript가 직접 저장해 둔 현재 보물 위치의 '블록 객체'와 비교
    # 숫자 좌표/Location 문자열 비교를 사용하지 않음
    set {_treasureBlock} to block at {treasure.selected::%{_stage}%}

    if event-block is not {_treasureBlock}:
        # 테스트 중에는 왜 무시됐는지 바로 알 수 있게 표시
        if {treasure.testmode} is true:
            if player is {treasure.tester}:
                set {_cx} to x-coordinate of event-block
                set {_cy} to y-coordinate of event-block
                set {_cz} to z-coordinate of event-block
                set {_raw} to {treasure.selectedRaw::%{_stage}%}
                send "{@treasure-prefix}&c이 블록은 현재 보물이 아닙니다. &7클릭: %{_cx}% %{_cy}% %{_cz}% / 목표: %{_raw}%" to player
        stop

    cancel event

    # -----------------------------------------------------
    # 1인 테스트
    # 같은 현재 보물을 세 번 누르면 완료
    # -----------------------------------------------------
    if {treasure.testmode} is true:
        if player is not {treasure.tester}:
            stop

        if {treasure.testClicks::%{_stage}%} is not set:
            set {treasure.testClicks::%{_stage}%} to 0

        add 1 to {treasure.testClicks::%{_stage}%}
        set {_count} to {treasure.testClicks::%{_stage}%}

        if {_count} > 3:
            set {_count} to 3
            set {treasure.testClicks::%{_stage}%} to 3

        send "{@treasure-prefix}&6테스트 보물 확인: &f%{_count}%&7/3" to player
        send title "&6&l보물 확인" with subtitle "&f%{_count}% / 3" to player

    # -----------------------------------------------------
    # 본게임
    # 말 못함 / 못 들음 / 안 보임이 각각 한 번씩 클릭
    # -----------------------------------------------------
    else:
        if isTreasurePlayer(player) is false:
            stop

        if player is {treasure.mute}:
            set {treasure.clicked::%{_stage}%::mute} to true

        else if player is {treasure.deaf}:
            set {treasure.clicked::%{_stage}%::deaf} to true

        else if player is {treasure.blind}:
            set {treasure.clicked::%{_stage}%::blind} to true

        set {_count} to 0

        if {treasure.clicked::%{_stage}%::mute} is true:
            add 1 to {_count}
        if {treasure.clicked::%{_stage}%::deaf} is true:
            add 1 to {_count}
        if {treasure.clicked::%{_stage}%::blind} is true:
            add 1 to {_count}

        loop {treasure.players::*}:
            if loop-value is online:
                send title "&6&l보물 확인" with subtitle "&f%{_count}% / 3" to loop-value

    if {_count} < 3:
        stop

    # 이미 처리된 단계면 중복 처리 금지
    if {treasure.completed::%{_stage}%} is true:
        stop
    set {treasure.completed::%{_stage}%} to true

    # 현재 보물 제거
    set event-block to air

    loop {treasure.players::*}:
        if loop-value is online:
            send title "&6&l%{_stage}%번째 보물 발견!" with subtitle "&f보물 확인이 완료되었습니다." to loop-value for 4 seconds

    # 3번째 보물은 게임 최종 완료
    if {_stage} is 3:
        # 마지막 보물 확인이 끝난 정확한 순간 타이머 정지
        set {treasure.timer.running} to false
        set {_finalSeconds} to {treasure.timer.seconds}
        set {_finalTime} to formatTreasureTime({_finalSeconds})

        set {_rank} to 0

        # 공식 3인 플레이만 TOP 10 랭킹에 저장
        if {treasure.testmode} is not true:
            set {_rank} to saveTreasureRanking({_finalSeconds})

        wait 1 second

        if {treasure.active} is true:
            loop {treasure.players::*}:
                if loop-value is online:
                    if {treasure.testmode} is true:
                        send title "&a&l보물찾기 테스트 성공!" with subtitle "&f기록 %{_finalTime}% &7(공식 랭킹 미등록)" to loop-value for 7 seconds
                    else:
                        if {_rank} > 0:
                            send title "&a&l보물찾기 성공!" with subtitle "&f기록 %{_finalTime}% &e- TOP %{_rank}%위" to loop-value for 7 seconds
                        else:
                            send title "&a&l보물찾기 성공!" with subtitle "&f기록 %{_finalTime}%" to loop-value for 7 seconds

            wait 3 seconds
            clearTreasureGame()

        stop

    # 1/2번째 완료 후 5x5 미니게임 단계로
    set {treasure.puzzle.number} to {_stage}
    set {treasure.puzzle.pending} to true
    set {treasure.puzzle.active} to false
    set {treasure.puzzle.revealing} to false
    set {treasure.puzzle.near} to 0
    set {treasure.puzzle.expected} to size of {treasure.players::*}

    delete {treasure.puzzle.correct::*}
    delete {treasure.puzzle.unlocked::*}
    delete {treasure.testClicks::%{_stage}%}

    # 미니게임 대기 상태가 되면 25칸을 확실히 흰색으로 초기화
    paintPuzzleHidden()

    wait 1 second

    if {treasure.active} is true:
        loop {treasure.players::*}:
            if loop-value is online:
                send title "&d&l정보 해금 미션" with subtitle "&f5x5 미니게임 장소로 이동하세요." to loop-value for 5 seconds

# ---------------------------------------------------------
# 미니게임 자동 시작
# 참가자 전원이 중앙 반경 안으로 들어오면 패턴 공개
# ---------------------------------------------------------

every 1 second:
    if {treasure.active} is not true:
        stop

    if {treasure.puzzle.pending} is not true:
        stop

    if {treasure.puzzle.revealing} is true:
        stop

    if {treasure.puzzle.active} is true:
        stop

    set {_center} to location(-22, 16, -293, {treasure.world})
    set {_expected} to size of {treasure.players::*}
    set {_near} to 0

    loop {treasure.players::*}:
        if loop-value is online:
            if world of loop-value is {treasure.world}:
                if distance between location of loop-value and {_center} <= {@puzzle-start-radius}:
                    add 1 to {_near}

    set {treasure.puzzle.near} to {_near}
    set {treasure.puzzle.expected} to {_expected}

    if {_near} < {_expected}:
        stop

    # 중복 실행 방지: 패턴 생성 전에 pending을 먼저 내림
    set {treasure.puzzle.pending} to false
    set {treasure.puzzle.revealing} to true
    set {treasure.puzzle.active} to false

    delete {treasure.puzzle.correct::*}
    delete {treasure.puzzle.unlocked::*}

    # 1~25 중 서로 다른 정답 패널을 랜덤 선정
    delete {_pool::*}
    loop 25 times:
        add loop-number to {_pool::*}

    loop {@puzzle-correct-count} times:
        set {_pick} to random element out of {_pool::*}
        remove {_pick} from {_pool::*}
        set {treasure.puzzle.correct::%{_pick}%} to true

    # 패턴 공개
    # 정답 = 라임 콘크리트
    # 오답 = 회색 콘크리트
    loop 25 times:
        set {_tile} to puzzleTileLoc(loop-number)

        if {treasure.puzzle.correct::%loop-number%} is true:
            set block at {_tile} to lime concrete
        else:
            set block at {_tile} to gray concrete

    loop {treasure.players::*}:
        if loop-value is online:
            send "{@treasure-prefix}&e미니게임이 시작되었습니다. 정답 패턴을 기억하세요!" to loop-value
            send title "&e&l패턴을 기억하세요!" with subtitle "&f{@puzzle-reveal-seconds}초 뒤 패널이 모두 가려집니다." to loop-value

    wait {@puzzle-reveal-seconds} seconds

    if {treasure.active} is not true:
        stop

    if {treasure.puzzle.revealing} is not true:
        stop

    # 입력 단계: 25칸을 전부 흰색으로 가림
    paintPuzzleHidden()

    set {treasure.puzzle.revealing} to false
    set {treasure.puzzle.active} to true

    loop {treasure.players::*}:
        if loop-value is online:
            if {treasure.testmode} is true:
                send "{@treasure-prefix}&f입력 시작! 흰색 패널 중 정답 8개를 우클릭하세요." to loop-value
                send title "&f&l입력 시작" with subtitle "&8정답 패널을 우클릭하세요." to loop-value for 5 seconds
            else:
                send "{@treasure-prefix}&f입력 시작! 안 보이는 사람이 정답 패널을 우클릭해야 합니다." to loop-value
                send title "&f&l입력 시작" with subtitle "&8안 보이는 사람이 패널을 우클릭하세요." to loop-value for 5 seconds

# ---------------------------------------------------------
# 5x5 우클릭 미니게임 입력
# ---------------------------------------------------------
#
# 중요:
# 1인 테스트와 공식 3인 플레이 모두 완전히 동일한 클릭 판정 경로를 사용합니다.
# 블록 종류를 이벤트 선언부에서 필터링하지 않습니다.
# 서버/Skript 조합에 따라 "on right click on white concrete"가
# 정상적으로 로드되어도 실제 클릭을 놓치는 경우를 피하기 위해
# 모든 우클릭을 받은 뒤 clicked block을 직접 검사합니다.
# ---------------------------------------------------------

on any right click with priority highest:
    if {treasure.active} is not true:
        stop

    if {treasure.puzzle.active} is not true:
        stop

    # 클릭한 블록이 없는 우클릭(공중 우클릭 등)은 무시
    if clicked block is not set:
        stop

    # 테스트/본게임 입력자 제한
    if {treasure.testmode} is true:
        if player is not {treasure.tester}:
            stop
    else:
        if player is not {treasure.blind}:
            stop

    # 여기까지 들어왔으면 퍼즐 중 실제 블록 우클릭은 감지된 것
    set {_type} to type of clicked block

    # Skript의 block 좌표 표현은 블록 중심점(.5)으로 들어올 수 있으므로
    # 반드시 floor 처리해서 실제 블록 좌표 정수값으로 변환
    set {_x} to floor(x-coordinate of clicked block)
    set {_y} to floor(y-coordinate of clicked block)
    set {_z} to floor(z-coordinate of clicked block)

    # 미니게임 5x5 범위 확인
    if {_y} is not 15:
        stop
    if {_x} < -24:
        stop
    if {_x} > -20:
        stop
    if {_z} < -295:
        stop
    if {_z} > -291:
        stop

    # 입력 단계에서 눌러야 하는 것은 흰색 패널
    if {_type} is lime concrete:
        cancel event
        send action bar "&7이미 언락한 패널입니다." to player
        stop

    if {_type} is not white concrete:
        stop

    cancel event

    # 좌표 -> 1~25 인덱스
    set {_row} to {_x} + 24
    set {_col} to {_z} + 295
    set {_index} to ({_row} * 5) + {_col} + 1

    # -----------------------------------------------------
    # 정답 패널
    # -----------------------------------------------------
    if {treasure.puzzle.correct::%{_index}%} is true:
        if {treasure.puzzle.unlocked::%{_index}%} is true:
            send action bar "&7이미 언락한 패널입니다." to player
            stop

        set {treasure.puzzle.unlocked::%{_index}%} to true
        set clicked block to lime concrete

        set {_count} to size of {treasure.puzzle.unlocked::*}

        loop {treasure.players::*}:
            if loop-value is online:
                send action bar "&a패널 언락 &f%{_count}%&7/{@puzzle-correct-count}" to loop-value

        if {treasure.testmode} is true:
            send "{@treasure-prefix}&a정답! &f%{_count}%&7/{@puzzle-correct-count}" to player

        if {_count} >= {@puzzle-correct-count}:
            # 중복 입력을 즉시 차단
            set {treasure.puzzle.active} to false

            loop {treasure.players::*}:
                if loop-value is online:
                    send "{@treasure-prefix}&a모든 정답 패널을 언락했습니다!" to loop-value

            wait 5 ticks

            if {treasure.active} is true:
                completePuzzle()

        stop

    # -----------------------------------------------------
    # 오답 패널
    # -----------------------------------------------------
    set clicked block to red concrete

    loop {treasure.players::*}:
        if loop-value is online:
            send "{@treasure-prefix}&c오답 패널입니다. 미션 실패!" to loop-value
            send title "&c&l미션 실패" with subtitle "&f시작 지점으로 이동합니다." to loop-value for 3 seconds

    wait 5 ticks

    if {treasure.active} is true:
        failPuzzle()

# ---------------------------------------------------------
# 미니게임 영역 보호
# ---------------------------------------------------------

on break:
    if {treasure.active} is not true:
        stop
    if world of player is not {treasure.world}:
        stop

    set {_loc} to location of event-block
    set {_x} to x-coordinate of {_loc}
    set {_y} to y-coordinate of {_loc}
    set {_z} to z-coordinate of {_loc}

    if {_y} is 15:
        if {_x} >= -24:
            if {_x} <= -20:
                if {_z} >= -295:
                    if {_z} <= -291:
                        cancel event
                        stop

    # 현재/미래 보물 좌표도 게임 중 파괴 방지
    loop 3 times:
        set {_raw} to {treasure.selectedRaw::%loop-number%}

        if {_raw} is set:
            set {_p::*} to {_raw} split at " "
            set {_tx} to {_p::1} parsed as number
            set {_ty} to {_p::2} parsed as number
            set {_tz} to {_p::3} parsed as number

            if {_x} is {_tx}:
                if {_y} is {_ty}:
                    if {_z} is {_tz}:
                        cancel event
                        stop

on place:
    if {treasure.active} is not true:
        stop
    if world of player is not {treasure.world}:
        stop

    set {_loc} to location of event-block
    set {_x} to x-coordinate of {_loc}
    set {_y} to y-coordinate of {_loc}
    set {_z} to z-coordinate of {_loc}

    if {_y} is 15:
        if {_x} >= -24:
            if {_x} <= -20:
                if {_z} >= -295:
                    if {_z} <= -291:
                        cancel event

# ---------------------------------------------------------
# 참가자 이탈 시 안전 종료
# ---------------------------------------------------------

on quit:
    set {_key} to "%player%"
    delete {treasure.gui.map::%{_key}%::*}
    delete {treasure.gui.mute::%{_key}%}
    delete {treasure.gui.deaf::%{_key}%}
    delete {treasure.gui.blind::%{_key}%}

    if {treasure.active} is not true:
        stop
    if isTreasurePlayer(player) is false:
        stop

    # 나가는 플레이어의 상태 효과 전부 제거
    set {_n} to name of player
    execute console command "effect clear %{_n}%"

    broadcast "{@treasure-prefix}&c참가자 %player% 님이 이탈하여 게임을 종료합니다."
    clearTreasureGame()
